# Copy to .env and fill in. .env is gitignored -- never commit it.
# Loaded automatically by `python -m cos2pag` (see --env-file to use a
# different path).

# COS Service API (osiris-109-a-fe.ctie.etat.lu:8338), basic auth
COS_USERNAME=
COS_PASSWORD=
# Only needed if you switch cos.auth.type to "bearer" in config.yaml
COS_API_TOKEN=

# PAG Administration API (scrat-1.ctie.etat.lu:4200), basic auth
PAG_USERNAME=
PAG_PASSWORD=

# PDR Administration API (hathor-1.ctie.etat.lu:3601), basic auth
PDR_USERNAME=
PDR_PASSWORD=

# S3 credentials PDR uses to read from the COS bucket (source_s3)
PDR_COS_ACCESS_KEY=
PDR_COS_SECRET_KEY=

# S3 credentials PDR uses to write to the PAG repository (target_s3),
# tied to the PAG "pdr" user
PDR_PAG_ACCESS_KEY=
PDR_PAG_SECRET_KEY=
